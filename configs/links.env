#!/bin/bash

ARCH="$(uname -m)"

SHORT_ARCH=""

case ${ARCH} in
	aarch64)
		SHORT_ARCH=arm64
		;;
	x86_64)
		SHORT_ARCH=amd64
		;;
esac

# Zellij
ZJ_ver="v0.45.1"
ZJ_url="https://github.com/zellij-org/zellij/releases/download/${ZJ_ver}/zellij-${ARCH}-unknown-linux-musl.tar.gz"

# Fish
FISH_ver="4.9.2"
FISH_url="https://github.com/fish-shell/fish-shell/releases/download/${FISH_ver}/fish-${FISH_ver}-linux-${ARCH}.tar.xz"

# Yq
YQ_ver="v4.53.6"
YQ_url="https://github.com/mikefarah/yq/releases/download/${YQ_ver}/yq_linux_${SHORT_ARCH}.tar.gz"

# Vim-Plug
VP_ver="0.14.0"
VP_url="https://github.com/junegunn/vim-plug/archive/refs/tags/${VP_ver}.tar.gz"

# Fuggitive 
FUGITIVE_ver="v3.7"
FUGITIVE_url="https://github.com/tpope/vim-fugitive/archive/refs/tags/${FUGITIVE_ver}.tar.gz"

# Surround
SURROUND_ver="v2.2"
SURROUND_url="https://github.com/tpope/vim-surround/archive/refs/tags/${SURROUND_ver}.tar.gz"

# Airline
AIRLINE_ver="v0.12"
AIRLINE_url="https://github.com/vim-airline/vim-airline/archive/refs/tags/${AIRLINE_ver}.tar.gz"

# Airline-themes
AIRTHEMES_tag="master"
AIRTHEMES_git="https://github.com/vim-airline/vim-airline-themes.git"

# Gitgutter
GITGUTTER_tag="main"
GITGUTTER_git="https://github.com/airblade/vim-gitgutter.git"

# Nord-vim
NORDVIM_tag="main"
NORDVIM_git="https://github.com/nordtheme/vim.git"

# ZJStatus
ZJSTATUS_ver="v0.25.0"
ZJSTATUS_url="https://github.com/dj95/zjstatus/archive/refs/tags/${ZJSTATUS_ver}.tar.gz"
ZJSTATUS_wasm_url="https://github.com/dj95/zjstatus/releases/download/${ZJSTATUS_ver}/zjstatus.wasm"
