#!/bin/bash

ZJPLUG-wasm() {
	local PLUG_name="$1"
	local PLUG_ver="$2"
	local PLUG_url="$3"
	
	local PLUG_pathF="${HOME}/.config/zellij/plugins/${PLUG_name}-${PLUG_ver}.wasm"
	
	if [ ! -d "${PLUG_pathF}" ]; then
		LOG-info "install ${PLUG_name} (${PLUG_ver})..."
		LOG-cmd wget "$PLUG_url" -O "${PLUG_pathF}"
	else
		LOG-info "${PLUG_name} (${PLUG_ver}) already installed..."
	fi
}

SETUP-zellij() {
	LOG-info "Setup zellij..."

	local ZJC_path="${HOME}/.config/zellij"
	local ZJC_config="${ZJC_path}/config.kdl"
	local ZJC_plugins="${ZJC_path}/plugins"
	local ZJC_layouts="${ZJC_path}/layouts"
	local ZJC_customL="${ZJC_layouts}/custom.kdl"
	local ZJSTATUS_param2="
ui {
    pane_frames {
        rounded_corners true
    }
}"
	
	### CREATE DIRECTORIES
	CREATE-dir "${ZJC_path}"
	CREATE-dir "${ZJC_plugins}"
	CREATE-dir "${ZJC_layouts}"
	
	### CREATE CONFIG-FILE
	if [ ! -s $ZJC_config ]; then
		zellij setup --dump-config > "${ZJC_config}"
		echo '' >> $ZJC_config
	fi
	
	### CREATE LAYOUT-FILE
	if [ -s $ZJC_customL ]; then
		rm "${ZJC_customL}"
	fi
	zellij setup --dump-layout default > "${ZJC_customL}"
	
	### EDIT CONFIG-FILE
	WRITE-sed-end 'default_layout "custom"' "$ZJC_config"
	WRITE-sed-end 'theme "nord"' "$ZJC_config"
	WRITE-sed-end 'pane_frame_style "full"' "$ZJC_config"
	WRITE-sed-end 'show_startup_tips false' "$ZJC_config"
	
	case $XDG_SESSION_TYPE in
		"x11" )
			WRITE-sed-end 'copy_command "xclip -selection clipboard"' "${ZJC_config}"
			;;
		"wayland" )
			WRITE-sed-end 'copy_command "wl-copy"' "${ZJC_config}"
			;;
		"osx" )
			WRITE-sed-end 'copy_command "pbcopy"' "${ZJC_config}"
			;;
	esac
	
	WRITE-eof-add "${ZJSTATUS_param2}" "${ZJC_config}"

	# ZJPLUG-src "zj-status" "${ZJSTATUS_ver}" "${ZJSTATUS_url}" ".tar.gz" "zjstatus-0.25.0"
	ZJPLUG-wasm "zj-status" "${ZJSTATUS_ver}" "${ZJSTATUS_url}"

	### ADD PLUGIN ZJ-STATUS
	local ZJSTATUS_wasm="zjstatus-${ZJSTATUS_ver}.wasm"
	read -r -d '' ZJSTATUS_param1 <<EOF || true 
	"file:${ZJC_plugins}/${ZJSTATUS_wasm}" {
		format_left  "{mode}#[fg=#89B4FA,bg=#181825,bold] {session}#[bg=#181825] {tabs}"
		format_right "{command_kubectx}#[fg=#424554,bg=#181825]::{command_kubens}{datetime}"
		format_space "#[bg=#181825]"
		
		mode_normal          "#[bg=#89B4FA] "
		mode_tmux            "#[bg=#ffc387] "
		mode_default_to_mode "tmux"
		
		tab_normal               "#[fg=#6C7086,bg=#181825] {index} {name} {fullscreen_indicator}{sync_indicator}{floating_indicator}"
		tab_active               "#[fg=#9399B2,bg=#181825,bold,italic] {index} {name} {fullscreen_indicator}{sync_indicator}{floating_indicator}"
		tab_fullscreen_indicator "□ "
		tab_sync_indicator       "  "
		tab_floating_indicator   "󰉈 "
		
		command_kubectx_command  "kubectx -c"
		command_kubectx_format   "#[fg=#6C7086,bg=#181825,italic] {stdout}"
		command_kubectx_interval "2"
		
		command_kubens_command  "kubens -c"
		command_kubens_format   "#[fg=#6C7086,bg=#181825]{stdout} "
		command_kubens_interval "2"
		
		datetime          "#[fg=#9399B2,bg=#181825] {format} "
		datetime_format   "%A, %d %b %Y %H:%M"
		datetime_timezone "Europe/Berlin"
	}
EOF
	
	TMP_customL="$(mktemp custom_wmXXX --suffix=.kdl)"
	LOG-info "Create temp-file $TMP_customL"

	awk -v old_text="\"tab-bar\"" -v new_text="$ZJSTATUS_param1" '
	index($0, old_text) {
		line = $0
		sub(old_text, new_text, line)
		print line
		next
	}
	{
		print
	}
	' "$ZJC_customL" > "$TMP_customL" && mv "$TMP_customL" "$ZJC_customL"
}
