#!/bin/bash

EXIT-vimrc() {
	local FILE="$1"

	LOG-info "Edit ${FILE}..."
	cat <<EOF > $FILE
:set nu
:set tabstop=4
:set cursorline

:hi CursorLine cterm = bold
:hi CursorLineNr cterm = bold

call plug#begin('~/.vim/plugged')
	Plug 'tpope/vim-fugitive'
	Plug 'tpope/vim-surround'
	Plug 'vim-airline/vim-airline'
	Plug 'vim-airline/vim-airline-themes'
	Plug 'airblade/vim-gitgutter'
	Plug 'arcticicestudio/nord-vim'
call plug#end()

let g:airline_powerline_fonts = 1
let g:airline_theme = 'nord'
let g:gitgutter_enabled = 1
let g:airline#extensions#whitespace#enabled = 0

colorscheme nord
EOF
}

# Install tar-source
VIMPLUG-src() {
	local PLUG_name="$1"
	local PLUG_ver="$2"
	local PLUG_url="$3"
	local ARCH_postfix="$4"
	local PLUG_extr="${RES_srcs}/$5"

	local PLUG_pathF="${HOME}/.vim/plugged/${PLUG_name}"
	local ARCH_path="${RES_archs}/${PLUG_name}-${PLUG_ver}${ARCH_postfix}"

	if [ ! -d "${PLUG_pathF}" ]; then
		LOG-info "install ${PLUG_name} (${PLUG_ver}) to ${PLUG_pathF}..."
		if [ ! -s "${ARCH_path}" ]; then
			# Download archive to /resources/archives
			LOG-cmd wget "${PLUG_url}" -O "${ARCH_path}"
		fi
		# Extract from /resources/archives to /resources/srcs
		LOG-cmd tar -xvf "${ARCH_path}" -C "${RES_srcs}"
		mv "${PLUG_extr}" "${PLUG_pathF}"
	else
		LOG-info "${PLUG_name} (${PLUG_ver}) already installed..."
	fi
}

# Cloning git-repository
VIMPLUG-git() {
	local PLUG_name="$1"
	local PLUG_tag="$2"
	local PLUG_git="$3"

	local PLUG_pathF="${HOME}/.vim/plugged/${PLUG_name}"
	
	if [ ! -d "${PLUG_pathF}" ]; then
		LOG-info "cloning ${PLUG_name} (${PLUG_tag}) to ${PLUG_pathF}..."
		git clone -b "${PLUG_tag}" "${PLUG_git}" "${PLUG_pathF}"
	else
		LOG-info "${PLUG_name} (${PLUG_tag}) already cloned..."
	fi
}

# install and setup Vim-Plug
SETUP-vimplug() {
	LOG-info "Installing Vim-Plug (${VP_ver})..."
	
	# download and untar archive
	local VP_tar="${RES_archs}/vp-${VP_ver}.tar.gz"
	local VP_src="${RES_srcs}/vim-plug-${VP_ver}"
	
	if [ ! -d "$VP_src" ]; then
		if [ ! -f ${VP_tar} ]; then 
			LOG-cmd wget "$VP_url" -O "$VP_tar"
		fi
		LOG-cmd tar -xvf "$VP_tar" -C "$RES_srcs"
	fi
	
	local AUTOLOAD="${HOME}/.vim/autoload"
	local PLUGGED="${HOME}/.vim/plugged"
	local PLUG_VIM="${VP_src}/plug.vim"

	local VIMRC="${HOME}/.vimrc"

	if [ ! -d "${PLUGGED}" ]; then
		LOG-cmd mkdir -p "${PLUGGED}"
	fi

	if [ ! -d "$AUTOLOAD" ]; then
		LOG-cmd mkdir -p "$AUTOLOAD"
	fi
	
	VIMPLUG-src "fugitive" "${FUGITIVE_ver}" "${FUGITIVE_url}" ".tar.gz" "vim-fugitive-3.7" 
	VIMPLUG-src "airline" "${AIRLINE_ver}" "${AIRLINE_url}" ".tar.gz" "vim-airline-0.12"
	
	VIMPLUG-git "airline-theme" "${AIRTHEMES_tag}" "${AIRTHEMES_git}"
	VIMPLUG-git "gitgutter" "${GITGUTTER_tag}" "${GITGUTTER_git}"
	VIMPLUG-git "nord-vim" "${NORDVIM_tag}" "${NORDVIM_git}"

	# add plug.vim
	LOG-info "${PLUG_VIM}"
	LOG-info "${AUTOLOAD}"
	if [ ! -f "${AUTOLOAD}/plug.vim" ]; then
		LOG-cmd cp "$PLUG_VIM" "$AUTOLOAD/plug.vim"
	fi

	cat <<EOF > ${VIMRC}
:set nu
:set tabstop=4
:set cursorline

:hi CursorLine cterm = bold
:hi CursorLineNr cterm = bold

call plug#begin('~/.vim/plugged')
	Plug 'file://${PLUGGED}/fugitive'
	Plug 'file://${PLUGGED}/airline'
	Plug 'file://${PLUGGED}/airline-theme'
	Plug 'file://${PLUGGED}/gitgutter'
	Plug 'file://${PLUGGED}/nord-vim'
call plug#end()

let g:airline_powerline_fonts = 1
let g:airline_theme = 'nord'
let g:gitgutter_enabled = 1
let g:airline#extensions#whitespace#enabled = 0

colorscheme nord
EOF
}
